$ cat /etc/systemd/system/tcp-image-server-skin.service
[Unit]
Conflicts=tcp-image-server.service
Description=tcp_image server with ISIC skin-lesion weights (same bitstream)
Documentation=file:/root/tcp_image_rx/README.md
# 绑定 0.0.0.0, 其实不依赖 IP 就绪; 但等网络起来更稳妥
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/tcp_image_rx

# ── 启动参数(改这里之后执行: systemctl daemon-reload && systemctl restart tcp-image-server) ──
#   -p 5060          监听端口, 要和 PC 端 GUI/CLI 的 -P 一致
#   -a 0x40000000    图像缓冲区, 用设备树里已保留的 no-map 区(厂商留的 buffer@0)
#   --no-dma         暂不开 AXI DMA(PL 侧的 Block Design 还没做)
#   --echo           收到后原样回发, PC 端 GUI 靠它显示右图; 将来 PL 做好可去掉
#   -n 0             一直跑, 不退出
ExecStart=/root/skin/tcp_image_server_skin -p 5060 -a 0x40000000 --no-dma -x 0xA0000000 --echo -n 0 --ai-res 128

# 崩了自动拉起(每 2 秒最多一次)
Restart=always
RestartSec=2

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

