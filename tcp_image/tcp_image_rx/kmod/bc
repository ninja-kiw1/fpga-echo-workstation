#!/usr/bin/python3
# -*- coding: utf-8 -*-
"""最小 `bc` 替身 —— 只实现内核 Kbuild 用到的那一件事。

背景
----
FZ3B 的精简 rootfs 里**没有 bc**, 而 Linux 4.14 的顶层 `Kbuild` 用
    (echo $(CONFIG_HZ) | bc -q kernel/time/timeconst.bc) > include/generated/timeconst.h
生成时间换算常量, 于是 `make modules_prepare` 会以
    /bin/sh: 1: bc: not found   ->  Error 127
停住。板子没有外网, 装不了 bc。

做法
----
把 `kernel/time/timeconst.bc` 的算法**原样**用 Python 实现一遍
(同样的 gcd / fmul / fadj / fmuls 公式, 同样的打印顺序与进制切换),
所以输出与 bc 一致。**不改内核源码**, 只是让 `bc` 这个名字可用。

用法与 bc 相同:
    echo <hz> | bc -q <path>/timeconst.bc

只支持 timeconst.bc; 传别的脚本会**明确报错退出** —— 万一以后内核又用 bc 干别的事,
宁可失败也不要被静默糊弄。
"""
import os
import sys


def gcd(a, b):
    while b:
        a, b = b, a % b
    return a


def fmul(b, n, d):          # (2^b * n + d - 1) / d      (bc scale=0 -> 整除)
    return (2 ** b * n + d - 1) // d


def fadj(b, n, d):          # 2^b * (d-1) / d,  其中 d /= gcd(n, d)
    d = d // gcd(n, d)
    return 2 ** b * (d - 1) // d


def fmuls(b, n, d):         # 最小的 s 使 fmul(s, n, d) >= 2^(b-1)
    s = 0
    while True:
        if fmul(s, n, d) >= 2 ** (b - 1):
            return s
        s += 1


def emit(hz):
    o = []
    o.append("/* Automatically generated by kernel/time/timeconst.bc */")
    o.append("/* Time conversion constants for HZ == %d */" % hz)
    o.append("")
    o.append("#ifndef KERNEL_TIMECONST_H")
    o.append("#define KERNEL_TIMECONST_H")
    o.append("")
    o.append("#include <linux/param.h>")
    o.append("#include <linux/types.h>")
    o.append("")
    o.append("#if HZ != %d" % hz)
    o.append('#error "include/generated/timeconst.h has the wrong HZ value!"')
    o.append("#endif")
    o.append("")
    if hz < 2:
        o.append("#error Totally bogus HZ value!")
        return "\n".join(o) + "\n"

    s = fmuls(32, 1000, hz)
    o.append("#define HZ_TO_MSEC_MUL32\tU64_C(0x%X)" % fmul(s, 1000, hz))
    o.append("#define HZ_TO_MSEC_ADJ32\tU64_C(0x%X)" % fadj(s, 1000, hz))
    o.append("#define HZ_TO_MSEC_SHR32\t%d" % s)

    s = fmuls(32, hz, 1000)
    o.append("#define MSEC_TO_HZ_MUL32\tU64_C(0x%X)" % fmul(s, hz, 1000))
    o.append("#define MSEC_TO_HZ_ADJ32\tU64_C(0x%X)" % fadj(s, hz, 1000))
    o.append("#define MSEC_TO_HZ_SHR32\t%d" % s)

    cd = gcd(hz, 1000)
    o.append("#define HZ_TO_MSEC_NUM\t\t%d" % (1000 // cd))
    o.append("#define HZ_TO_MSEC_DEN\t\t%d" % (hz // cd))
    o.append("#define MSEC_TO_HZ_NUM\t\t%d" % (hz // cd))
    o.append("#define MSEC_TO_HZ_DEN\t\t%d" % (1000 // cd))
    o.append("")

    s = fmuls(32, 1000000, hz)
    o.append("#define HZ_TO_USEC_MUL32\tU64_C(0x%X)" % fmul(s, 1000000, hz))
    o.append("#define HZ_TO_USEC_ADJ32\tU64_C(0x%X)" % fadj(s, 1000000, hz))
    o.append("#define HZ_TO_USEC_SHR32\t%d" % s)

    s = fmuls(32, hz, 1000000)
    o.append("#define USEC_TO_HZ_MUL32\tU64_C(0x%X)" % fmul(s, hz, 1000000))
    o.append("#define USEC_TO_HZ_ADJ32\tU64_C(0x%X)" % fadj(s, hz, 1000000))
    o.append("#define USEC_TO_HZ_SHR32\t%d" % s)

    cd = gcd(hz, 1000000)
    o.append("#define HZ_TO_USEC_NUM\t\t%d" % (1000000 // cd))
    o.append("#define HZ_TO_USEC_DEN\t\t%d" % (hz // cd))
    o.append("#define USEC_TO_HZ_NUM\t\t%d" % (hz // cd))
    o.append("#define USEC_TO_HZ_DEN\t\t%d" % (1000000 // cd))

    cd = gcd(hz, 1000000000)
    o.append("#define HZ_TO_NSEC_NUM\t\t%d" % (1000000000 // cd))
    o.append("#define HZ_TO_NSEC_DEN\t\t%d" % (hz // cd))
    o.append("#define NSEC_TO_HZ_NUM\t\t%d" % (hz // cd))
    o.append("#define NSEC_TO_HZ_DEN\t\t%d" % (1000000000 // cd))
    o.append("")

    o.append("#endif /* KERNEL_TIMECONST_H */")
    return "\n".join(o) + "\n"


def selftest(hz):
    """确认常量真的能把 **jiffies 数**换成时间: 对 msec/usec 抽样验证。

    内核的用法是   result = (n * MUL32 + ADJ32) >> SHR32
    其中 n 是 jiffies, 结果应是 n * UNIT / hz  (UNIT = 1000 msec 或 1000000 usec),
    向下取整 —— 也就是 "HZ_TO_MSEC / HZ_TO_USEC" 的语义。
    抽样一批 n, 全对才算过。
    """
    for unit in (1000, 1000000):
        s = fmuls(32, unit, hz)
        mul = fmul(s, unit, hz)
        adj = fadj(s, unit, hz)
        n = 1
        while n <= 400000:
            want = (n * unit) // hz
            got = (n * mul + adj) >> s
            if got != want:
                return "FAIL unit=%d n=%d want=%d got=%d" % (unit, n, want, got)
            n = n * 2 + 1
    return "OK"


def main():
    args = [a for a in sys.argv[1:]]
    script = None
    for a in args:
        if a != "-q" and not a.startswith("-"):
            script = a
    if script is None or os.path.basename(script) != "timeconst.bc":
        sys.stderr.write("bc(shim): 只支持 kernel/time/timeconst.bc, 收到 %r\n"
                         % (script,))
        return 2

    raw = sys.stdin.read().strip()
    try:
        hz = int(raw.split()[0])
    except (IndexError, ValueError):
        sys.stderr.write("bc(shim): 读不到 HZ (stdin=%r)\n" % raw)
        return 2

    chk = selftest(hz)
    sys.stderr.write("bc(shim): hz=%d selftest=%s\n" % (hz, chk))
    if chk != "OK":
        return 3

    sys.stdout.write(emit(hz))
    return 0


if __name__ == "__main__":
    sys.exit(main())
